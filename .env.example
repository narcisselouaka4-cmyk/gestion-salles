# Exemple de configuration pour le déploiement local
# Copiez ce fichier en .env et remplissez vos valeurs

# ID de votre Google Sheet (optionnel - l'app fonctionne sans)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Configuration Google Service Account (optionnel)
# Ces valeurs sont nécessaires uniquement si vous voulez synchroniser avec Google Sheets
GOOGLE_CREDENTIALS_TYPE=service_account
GOOGLE_CREDENTIALS_PROJECT_ID=your_project_id
GOOGLE_CREDENTIALS_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_CREDENTIALS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_ICI\n-----END PRIVATE KEY-----"
GOOGLE_CREDENTIALS_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_CREDENTIALS_CLIENT_ID=your_client_id

# Configuration Notifications Email (SMTP) — optionnel
# Compte Gmail dédié avec "app password" (activer 2FA sur le compte Google puis générer un app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=cfpdc.notifications@gmail.com
SMTP_PASSWORD=your_app_password_16_chars
NOTIF_FROM_NAME=CFPDC Salles
# Heure d'envoi du récap quotidien (heure locale, 0-23) — défaut 20h
NOTIF_HEURE_QUOTIDIEN=20
# Mettre "false" pour désactiver globalement les notifications
NOTIF_ENABLED=true
