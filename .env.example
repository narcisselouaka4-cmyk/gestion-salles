# Exemple de configuration pour le déploiement local
# Copiez ce fichier en .env et remplissez vos valeurs

# ID de votre Google Sheet (optionnel - l'app fonctionne sans)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Configuration Google Service Account (optionnel)
# Ces valeurs sont nécessaires uniquement si vous voulez synchroniser avec Google Sheets
GOOGLE_CREDENTIALS_TYPE=service_account
GOOGLE_CREDENTIALS_PROJECT_ID=your_project_id
GOOGLE_CREDENTIALS_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_CREDENTIALS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nVOTRE_CLE_ICI\n-----END PRIVATE KEY-----"
GOOGLE_CREDENTIALS_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
GOOGLE_CREDENTIALS_CLIENT_ID=your_client_id

# ── Envoi d'emails ──
# IMPORTANT : sur Render (et beaucoup d'hébergeurs gratuits) le SMTP sortant est
# BLOQUÉ (erreur "Network is unreachable"). Utilisez l'API HTTP Brevo (gratuite,
# 300 emails/jour) qui passe par HTTPS.
#
# Brevo (recommandé sur Render) :
#   1. Créer un compte gratuit sur brevo.com
#   2. Vérifier votre adresse d'expéditeur (Senders)
#   3. Créer une clé API (SMTP & API > API Keys)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=cfpdc.notifications@gmail.com
NOTIF_FROM_NAME=CFPDC Salles
#
# SMTP (repli, fonctionne surtout en local — Gmail avec "app password") :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=cfpdc.notifications@gmail.com
SMTP_PASSWORD=your_app_password_16_chars
# Heure d'envoi du récap quotidien (heure locale, 0-23) — défaut 20h
# Le récap est envoyé la veille pour le lendemain, personnalisé par utilisateur :
#   - uniquement si au moins une salle SUIVIE par l'utilisateur est occupée ;
#   - en respectant ses jours actifs et ses salles suivies (réglés dans l'app).
# Les préférences par utilisateur sont stockées dans preferences/preferences.json.
NOTIF_HEURE_QUOTIDIEN=20
# Mettre "false" pour désactiver globalement les notifications
NOTIF_ENABLED=true

# Keep-alive (évite la mise en veille sur Render gratuit)
# Render fournit automatiquement RENDER_EXTERNAL_URL ; rien à configurer là-bas.
# Ping toutes les 10 min par défaut. Options :
# KEEPALIVE_ENABLED=true
# KEEPALIVE_INTERVAL=600
# KEEPALIVE_URL=https://votre-app.onrender.com   # pour forcer une URL précise
